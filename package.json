{
  "name": "hi-story",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:closure": "vitest run tests/quest-closure.test.ts tests/basic-attack-loop.test.ts tests/interaction-closure.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:closure": "playwright test tests/e2e/gameplay-closure.spec.ts",
    "characters:generate": "node tooling/generate-characters.mjs",
    "characters:render": "node tooling/render-characters.mjs",
    "check:boundaries": "node tooling/boundaries.mjs",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "maps:generate": "node tooling/generate-map.mjs",
    "characters:motions": "node tooling/export-character-motions.mjs"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
